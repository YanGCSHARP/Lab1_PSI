<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.104.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Иначе основной проект пытается скомпилировать тестовые файлы
         из подпапки tests, у которой своя (тестовая) сборка. -->
    <Compile Remove="tests\**\*.cs" />
    <!-- Лаб. 2 — отдельные проекты в lab2 со своей сборкой. -->
    <Compile Remove="lab2\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>ExamTicketGenerator.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>